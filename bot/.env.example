# NOVA VRFS Discord bot — copy to .env and fill in. NEVER commit the real .env.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to a single guild instantly (recommended while testing).
DISCORD_GUILD_ID=

# Supabase (service role key — server-side only, never ship to a browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: channel used for public announcements (results, fixtures, signings)
NOVA_ANNOUNCE_CHANNEL_ID=
# Optional: currency prefix used in embeds
NOVA_CURRENCY=£
